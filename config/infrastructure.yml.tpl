# =============================================================================
#  ШАБЛОН центрального конфигурационного файла инфраструктуры AD-Ruby.
#  ---------------------------------------------------------------------------
#  Этот файл (infrastructure.yml.tpl) упаковывается в дистрибутив и служит
#  примером/шпаргалкой. Настоящий НАСТРОЕННЫЙ файл config/infrastructure.yml
#  на целевом сервере автоматически генерирует скрипт setup.sh (вопросы →
#  ответы → файл).
#
#  Единый источник истины для:
#    - Rails-приложения  (app/services/ad_service.rb),
#    - скрипта Exchange  (scripts_for_exchange/enable_mailboxes.ps1).
#
#  ВАЖНО: файл содержит УЧЁТНЫЕ ДАННЫЕ (пароль) — не выкладывайте его
#  в публичные репозитории.
# =============================================================================

# --- Организация --------------------------------------------------------------
organization:
  name: "<название организации (заголовок приложения)>"

# --- Active Directory / домен -----------------------------------------------
ad:
  host: "<IP контроллера домена / LDAPS>"
  port: 636                                # LDAPS
  base: "<baseDN OU, где создаются пользователи, напр. OU=Users,DC=corp,DC=local>"
  terminated_ou: "<полный DN OU уволенных сотрудников>"
  domain: "<домен, напр. corp.local>"
  default_password: "<пароль по умолчанию для новых пользователей>"

# --- Microsoft Exchange ------------------------------------------------------
exchange:
  server: "<имя сервера Exchange, например EXCHANGE-01>"
  ip: "<IP сервера Exchange>"
  mailbox_db: "<база данных почтовых ящиков, напр. DB01>"
  primary_domain: "<primary SMTP-домен>"
  secondary_domain: "<secondary SMTP-домен>"
  excluded_ous:                             # OU, для которых ящики НЕ создаём
    - "<полное имя OU исключения №1>"
    - "<полное имя OU исключения №2>"

# --- Веб-сервер / прод --------------------------------------------------------
server:
  name: "<FQDN/имя веб-сервера>"
  ip: "<IP веб-сервера>"
